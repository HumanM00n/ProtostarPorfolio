# Copier en .env.local pour le dev local. En prod/preview : Vercel → Project → Settings → Environment Variables.
# Toutes sont facultatives en dev : sans elles, l'e-mail s'affiche dans la console et le rate limit est en mémoire.

# --- Envoi des e-mails (https://resend.com) ---
RESEND_API_KEY=
# Expéditeur : doit appartenir à un domaine vérifié chez Resend (sinon onboarding@resend.dev).
CONTACT_FROM_EMAIL="Site Protostar <site@protostar.racing>"
# Destinataire des messages (par défaut : contact.email dans src/data/site.ts).
CONTACT_TO_EMAIL=

# --- Rate limit partagé (https://upstash.com → Redis → REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anti-bot Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Back-office Keystatic (/keystatic) ---
# "github" = back-office en ligne (connexion GitHub, commits sur des branches contenu/…).
# Vide = mode local, disponible uniquement avec npm run dev.
NEXT_PUBLIC_KEYSTATIC_STORAGE=
# Générées par l'assistant Keystatic lors de la création de la GitHub App :
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
